# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/customer_support_db

# LLM Provider Configuration (OpenAI-compatible / MeshAPI / DeepSeek)
MODEL_NAME=deepseek/deepseek-v4-flash
MESHAPI_DEEPSEEK_API=your_meshapi_or_openai_api_key_here
BASE_URL=https://api.meshapi.ai/v1

# Optional Alternative Provider (Groq)
CHAT_GROQ=your_groq_api_key_here

# LangSmith Observability & Tracing (Optional)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=customer-support-agent
